module Matmul;
use Util:all;
use ControlFlow: {touch};
export all;

noinline double[m,p] matmul_cuda(double[m,n] x, double[n,p] y) {
  touch(); return with {
    (. <= [i,j] <= .) : sum({[k] -> x[i,k] * y[k,j]});
  } : genarray([m,p],0d);
}

noinline double[m,p] matmul_nocuda(double[m,n] x, double[n,p] y) {
  touch(); return with {
    #pragma nocuda
    (. <= [i,j] <= .) : sum({[k] -> x[i,k] * y[k,j]});
  } : genarray([m,p],0d);
}
