module Inc;
use Util:all;
use ControlFlow: {touch};
export all;

noinline double[n] inc_cuda(double[n] x) {
  touch(); return with {
    (. <= [i] <= .) : x[i] + 1d;
  } : genarray([n], 0d);
}

noinline double[n] inc_nocuda(double[n] x) {
  touch(); return with {
    #pragma nocuda
    (. <= [i] < .) : x[i] + 1d;
  } : genarray([n], 0d);
}

